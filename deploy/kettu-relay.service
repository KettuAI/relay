# A systemd unit for kettu-relay. Install it with:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin kettu-relay
#   sudo install -m 0755 kettu-relay /usr/local/bin/kettu-relay
#   printf 'KETTU_RELAY_DOMAIN=relay.example.com\nKETTU_RELAY_DATA=/var/lib/kettu-relay\n' | sudo tee /etc/kettu-relay.env
#   sudo install -m 0644 kettu-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now kettu-relay
#   journalctl -u kettu-relay   # shows the link to paste into Kettu
[Unit]
Description=Kettu relay
After=network-online.target
Wants=network-online.target

[Service]
User=kettu-relay
EnvironmentFile=/etc/kettu-relay.env
ExecStart=/usr/local/bin/kettu-relay
Restart=on-failure
StateDirectory=kettu-relay
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
